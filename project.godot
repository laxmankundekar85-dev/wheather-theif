; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Weather Thief"
config/description="A magical 2D adventure where you steal and control weather powers to restore balance to the world."
config/version="0.1.0"
run/main_scene="res://scenes/levels/verdantia_combat_outpost.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.05, 0.12, 1)
config/icon="res://assets/ui/icon.png"

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

GameManager="*res://autoload/game_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
WeatherManager="*res://autoload/weather_manager.gd"
SceneTransition="*res://autoload/scene_transition.gd"
EventBus3D="*res://autoload/event_bus_3d.gd"
CombatManager="*res://autoload/combat_manager.gd"
MissionManager="*res://autoload/mission_manager.gd"
LevelManager="*res://autoload/level_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

